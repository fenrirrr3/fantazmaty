# Przykładowa konfiguracja. Skopiuj do .env i uzupełnij. Plik .env nie trafia do repozytorium.
# Zmienne ustawione w środowisku procesu mają pierwszeństwo przed .env.

# development | test | production
DJANGO_ENV=development
DJANGO_SECRET_KEY=zmien-na-dlugi-losowy-ciag-co-najmniej-50-znakow
# Po zmianie klucza wpisz tu poprzedni (po przecinku kilka), aby nie tracić sesji i hasła skrzynki.
DJANGO_SECRET_KEY_FALLBACKS=
# Domyślnie włączone tylko dla development; na produkcji musi być false.
DJANGO_DEBUG=true
# Na produkcji wymagane: konkretne nazwy hostów, bez "*".
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# Baza MySQL (projekt nie obsługuje innych silników).
DJANGO_DB_NAME=fantazmaty
DJANGO_DB_USER=fantazmaty
DJANGO_DB_PASSWORD=
DJANGO_DB_HOST=127.0.0.1
DJANGO_DB_PORT=3306
DJANGO_DB_CONN_MAX_AGE=0
DJANGO_DB_CONNECT_TIMEOUT=10

# Bezpieczeństwo (na produkcji domyślnie true; HSTS włącz po sprawdzeniu HTTPS).
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
# Tylko za zaufanym proxy, które samo ustawia X-Forwarded-Proto.
DJANGO_TRUST_PROXY_SSL_HEADER=false
# PythonAnywhere (HTTPS kończony na load balancerze): ustaw true.

# Limit prób logowania: adres klienta. Lokalnie i na własnym serwerze REMOTE_ADDR.
# Na PythonAnywhere ustaw HTTP_X_REAL_IP (platforma nadpisuje ten nagłówek).
AUTH_THROTTLE_CLIENT_IP_HEADER=REMOTE_ADDR
# Limit prób logowania i resetu hasła (false wyłącza go całkowicie).
AUTH_THROTTLE_ENABLED=true

# Poczta (na produkcji domyślnie SMTP i wymagany DJANGO_EMAIL_HOST).
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=true
DJANGO_EMAIL_USE_SSL=false
DJANGO_EMAIL_TIMEOUT=15
DJANGO_DEFAULT_FROM_EMAIL=Fantazmaty CMS <noreply@fantazmaty.pl>
DJANGO_SERVER_EMAIL=
DJANGO_PASSWORD_RESET_TIMEOUT=3600
# Ważność linku z zaproszenia do CMS-u (dni).
ACCOUNT_INVITATION_DAYS=7
DJANGO_LOG_LEVEL=INFO

# Programy dokumentów: interpreter konwertera (pełna ścieżka, opcjonalnie)
# i długość kolejki (konwerter przetwarza dokumenty po kolei, reszta czeka).
DOCUMENT_CONVERTER_PYTHON=
PROGRAM_MAX_QUEUED_JOBS=5
# Katalog kolejki dziennika aktywności (puste – var/activity-spool w katalogu projektu).
ACTIVITY_SPOOL_DIR=

# Integracje (opcjonalne).
DROPBOX_CHOOSER_APP_KEY=
# Udostępnianie folderów Dropbox (aplikacja Scoped, Full Dropbox; README: „Udostępnianie folderów Dropbox”).
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
# Folder główny z podfolderami do wyboru (domyślnie /Fantazmaty).
DROPBOX_ROOT_FOLDER=
# Klucz dla strony fantazmaty.pl (nagłówek X-Site-Key przy pobieraniu ekipy); ten sam wpisz w wp-config.php jako FZ_CMS_KEY.
SITE_API_KEY=
# JSON: {"Nazwa kanału": "https://discord.com/api/webhooks/..."}
DISCORD_WEBHOOKS={}
# Bot Discorda do nadawania rang według ról w CMS-ie (README: „Rangi Discorda”). Puste – funkcja wyłączona.
DISCORD_BOT_TOKEN=
# ID serwera Discorda (prawy przycisk na serwerze → Kopiuj ID serwera; wymaga trybu dewelopera).
DISCORD_GUILD_ID=
# Adres CMS-u w odnośnikach powiadomień Discord (puste – https://cms.fantazmaty.pl).
CMS_BASE_URL=
